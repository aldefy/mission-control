{
  "name": "@aldefy/mission-control",
  "version": "2.4.0",
  "description": "One local dashboard for all your AI coding work (Claude Code, Codex, any harness), with a Needs-you queue you can answer from your phone",
  "keywords": [
    "ai",
    "coding-agents",
    "dashboard",
    "claude-code",
    "observability",
    "agents",
    "developer-tools",
    "local-first",
    "tailscale",
    "pwa",
    "codex",
    "web-push"
  ],
  "license": "MIT",
  "author": "Adit Lal",
  "homepage": "https://github.com/aldefy/mission-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldefy/mission-control.git"
  },
  "bugs": {
    "url": "https://github.com/aldefy/mission-control/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mission-control": "bin/mission-control.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "FORMAT.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "dev": "vite web",
    "demo": "node scripts/demo.mjs",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test test/*.test.mjs",
    "test:web": "vitest run --root web",
    "typecheck": "tsc -p web --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
